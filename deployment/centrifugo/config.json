{
    "api_key": "${CENTRIFUGO_HTTP_API_KEY}",
    "api_insecure": false,
    "client_insecure": false,
    "client_allowed_origins": [
        "http://localhost",
        "http://localhost:80",
        "http://localhost:3000"
    ],
    "client_token_hmac_secret_key": "${CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY}",
    "namespaces": [
        {
            "name": "public",
            "publish": false,
            "subscribe": true,
            "presence": true,
            "presence_stats": true,
            "join_leave": true,
            "history_size": 10,
            "history_ttl": "60s"
        }
    ]
}
